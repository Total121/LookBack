# Copy to .env and fill in. Never commit .env.
# Cloud (Render): see DEPLOY.md — HOST=0.0.0.0, TRUST_PROXY=true, CLOUD=true

HOST=127.0.0.1
PORT=3947

# Set true on Render/Railway/Fly (or rely on auto-detect via RENDER/RAILWAY/FLY env)
CLOUD=false

# Only enable behind Cloudflare / a real reverse proxy. Default false = socket IP only.
TRUST_PROXY=false

# Admin login for /alb  (use a long random password)
ADMIN_USERNAME=your_admin_name
ADMIN_PASSWORD=replace_with_long_random_password

# Random secret ≥ 32 chars (session HMAC). Example generator:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_64_plus_hex_chars_minimum_thirty_two

# Session lifetime
SESSION_TTL_HOURS=12

# Cookie Secure flag: auto | true | false  (auto uses HTTPS / x-forwarded-proto)
COOKIE_SECURE=auto

# Cloudflare Turnstile — https://dash.cloudflare.com/ → Turnstile
TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Set false ONLY for local machine testing without Turnstile keys
REQUIRE_TURNSTILE=true

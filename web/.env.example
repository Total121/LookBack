# Copy to .env and fill in. Never commit .env.

HOST=127.0.0.1
PORT=3947

# Set true on managed hosts (or rely on auto-detect)
CLOUD=false

# Only enable behind a real reverse proxy. Default false = socket IP only.
TRUST_PROXY=false

# Obscure admin UI path — change this before sharing the site (not /alb).
# Example: /x7k9m2qpZ
ADMIN_PATH=/alb

# Persistent storage (paid host disk). Local leave empty.
# DATA_ROOT=/var/data
# Or override individually:
# VAULT_DIR=
# PENDING_DIR=
# DATA_DIR=

# Admin login (long random password, never a placeholder)
ADMIN_USERNAME=your_admin_name
ADMIN_PASSWORD=replace_with_long_random_password

# Random secret ≥ 32 chars (session HMAC):
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_64_plus_hex_chars_minimum_thirty_two

SESSION_TTL_HOURS=12

# Cookie Secure flag: auto | true | false
COOKIE_SECURE=auto

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Set false ONLY for local machine testing without Turnstile keys
REQUIRE_TURNSTILE=true
